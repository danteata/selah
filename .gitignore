# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
src-tauri/target
src-tauri/binaries/.venv-build
src-tauri/binaries/.venv-download
src-tauri/binaries/.build
src-tauri/binaries/dist
src-tauri/binaries/selah-whisper-server-*
!src-tauri/binaries/.gitkeep
# !src-tauri/assets/whisper-server
*.spec

src-tauri/assets/whisper-models/**/*.bin

# PyInstaller build output (whisper-server _internal/ + binary)
src-tauri/assets/whisper-server/
!src-tauri/assets/whisper-server/.gitkeep

# Downloaded embedding models and built embedding packs
src-tauri/assets/embedding-models/
src-tauri/assets/embedding-packs/
!src-tauri/assets/embedding-packs/.gitkeep

# IDE / tool internals
.kilo/
.openclaude/
src-tauri/binaries/.openclaude/

# Tauri generated schemas (auto-generated by `tauri dev` / `tauri build`)
src-tauri/gen/

# Handover docs (working notes, not source)
HANDOVER-*.md.commandcode/

# Session handover docs
HANDOVER-*.md
.commandcode/

# Test coverage output
coverage/

# Database files
*.db

# Lock files (use pnpm)
package-lock.json
yarn.lock

# Native GGUF Whisper model (fetched at build time by download-gguf-model.mjs)
src-tauri/assets/whisper-models-gguf/*.bin

# Homebrew ONNX Runtime staged for the Intel-mac CI build (system ort linking)
src-tauri/onnxruntime-libs/

# Windows transcribe-cpp runtime DLLs, staged by src-tauri/build.rs at build
# time and bundled next to the exe on Windows (see tauri.windows.conf.json).
src-tauri/windows-runtime/

# Linux transcribe-cpp shared libraries, staged by src-tauri/build.rs at build
# time and installed to /usr/lib/Selah/linux-runtime/ (see the `linux-runtime`
# entry in tauri.conf.json's bundle.resources, which the binary's $ORIGIN rpath
# points at). .gitkeep is committed because tauri-build FAILS on a resource glob
# that matches nothing — "glob pattern linux-runtime/**/* path not found or
# didn't match any files" — which would break the macOS and Windows builds, and
# any Linux build without the native-transcription feature.
src-tauri/linux-runtime/*
!src-tauri/linux-runtime/.gitkeep
