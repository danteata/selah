{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Selah",
    "version": "0.1.3",
    "identifier": "app.selah.desktop",
    "build": {
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3000"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "resources": [
            "assets/*",
            "assets/whisper-models-gguf/**/*",
            "assets/embedding-models/**/*",
            "assets/embedding-packs/**/*"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "macOS": {
            "frameworks": [],
            "minimumSystemVersion": "10.15"
        }
    },
    "app": {
        "security": {
            "csp": {
                "default-src": "'self' asset: https: data:",
                "script-src": "'self' https://*.clerk.accounts.dev",
                "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
                "img-src": "'self' asset: http://asset.localhost https://asset.localhost https: data: blob:",
                "font-src": "'self' asset: https: data: https://fonts.gstatic.com",
                "connect-src": "'self' https: wss: ipc: http://ipc.localhost http://asset.localhost asset: tauri: http://127.0.0.1:17493",
                "media-src": "'self' asset: http://asset.localhost https://asset.localhost https: blob:",
                "worker-src": "'self' blob:"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            },
            "capabilities": [
                "default"
            ]
        },
        "macOSPrivateApi": true,
        "windows": [
            {
                "title": "Selah - Church Presentation Software",
                "width": 1400,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 768,
                "resizable": true,
                "fullscreen": false,
                "devtools": true,
                "center": true
            }
        ],
        "withGlobalTauri": true
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/danteata/selah/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQTJGQTJFQTA0MDlFREEKUldUYW5rQ2dMdnFpTUkxQmhYcUY0eXd3VnRNb01UVzZTaG9xVlNVaGVsY1ovMkRYYTFaZ3czb3UK",
            "dangerousInsecureTransportProtocol": true
        },
        "shell": {
            "open": true
        }
    }
}