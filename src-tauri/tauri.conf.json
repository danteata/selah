{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Selah",
    "version": "0.1.0",
    "identifier": "app.selah.desktop",
    "build": {
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3000"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": false,
        "externalBin": [
            "binaries/selah-whisper-server"
        ],
        "resources": [
            "assets/*",
            "assets/whisper-models/**/*"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "macOS": {
            "frameworks": [],
            "minimumSystemVersion": "10.13"
        }
    },
    "app": {
        "security": {
            "csp": null,
            "capabilities": [
                "default"
            ]
        },
        "windows": [
            {
                "title": "Selah - Church Presentation Software",
                "width": 1400,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 768,
                "resizable": true,
                "fullscreen": false,
                "devtools": true,
                "center": true
            }
        ],
        "withGlobalTauri": true
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}