{
  "name": "selah",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "trustedDependencies": [
    "esbuild",
    "@esbuild/linux-x64",
    "@esbuild/linux-arm64",
    "@esbuild/darwin-x64",
    "@esbuild/darwin-arm64",
    "@esbuild/win32-x64",
    "@esbuild/win32-arm64"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop:prebuild": "node scripts/download-gguf-model.mjs && node scripts/download-embedding-model.mjs && npm run build-semantic-pack",
    "download-gguf-model": "node scripts/download-gguf-model.mjs",
    "download-embedding-model": "node scripts/download-embedding-model.mjs",
    "build-embedding-pack": "node scripts/build-embedding-pack.mjs",
    "build-dictionary-packs": "node scripts/build-dictionary-packs.mjs",
    "build-semantic-pack": "node scripts/build-embedding-pack.mjs --version WEB --file public/bibles/web.json --fragments",
    "build-semantic-pack:browser": "node scripts/build-embedding-pack.mjs --version WEB --file public/bibles/web.json && node scripts/build-web-embedding-pack.mjs --version WEB",
    "desktop:dev": "npm run desktop:prebuild && tauri dev",
    "desktop:dev:lite": "sh scripts/dev-lite.sh",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:mac": "tauri build --target universal-apple-darwin",
    "desktop:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "updater:serve": "node scripts/serve-updates.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.34.1",
    "@amplitude/unified": "^1.1.16",
    "@clerk/clerk-react": "^5.59.4",
    "@gsap/react": "^2.1.2",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@ricky0123/vad-react": "^0.0.36",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/react-query": "^5.90.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-font-family": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^12.34.0",
    "fuzzysort": "^3.1.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "mitt": "^3.0.1",
    "onnxruntime-web": "^1.24.2",
    "posthog-js": "^1.347.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.2",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.0",
    "three": "^0.184.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^17.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.0.0"
  }
}
