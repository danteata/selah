{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Selah",
    "version": "0.1.41",
    "identifier": "app.selah.mobile",
    "build": {
        "frontendDist": "../../dist",
        "devUrl": "http://localhost:3000"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Selah"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self' asset: https: data:",
                "script-src": "'self' 'wasm-unsafe-eval' https://*.clerk.accounts.dev",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: http://asset.localhost https://asset.localhost https: data: blob:",
                "font-src": "'self' asset: https: data:",
                "connect-src": "'self' https: wss: ipc: http://ipc.localhost http://asset.localhost asset: tauri: http://127.0.0.1:17493",
                "media-src": "'self' asset: http://asset.localhost https://asset.localhost https: blob:",
                "worker-src": "'self' blob:"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}